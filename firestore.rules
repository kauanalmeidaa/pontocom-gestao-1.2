rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function hasMe() { return exists(/databases/$(db)/documents/users/$(request.auth.uid)); }
    function me() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function inCompany(cid) { return signedIn() && hasMe() && me().companyId == cid; }
    function isOwner(cid) { return inCompany(cid) && me().role == 'dono'; }
    // o financeiro só abre para o dono ou para quem tem a permissão "finance"
    function canCol(c) {
      return me().role == 'dono' || c != 'finance'
        || (me().perms != null && 'finance' in me().perms);
    }

    // a quem cada pessoa pertence
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || inCompany(resource.data.companyId));
      allow create: if signedIn() && request.auth.uid == uid && (
        // dono criando a própria empresa (mesma gravação cria a empresa)
        ( request.resource.data.role == 'dono'
          && !exists(/databases/$(db)/documents/companies/$(request.resource.data.companyId))
          && getAfter(/databases/$(db)/documents/companies/$(request.resource.data.companyId)).data.ownerUid == uid )
        ||
        // entrando por convite válido (mesma gravação marca o convite como usado)
        ( get(/databases/$(db)/documents/invites/$(request.resource.data.inviteCode)).data.used == false
          && get(/databases/$(db)/documents/invites/$(request.resource.data.inviteCode)).data.companyId == request.resource.data.companyId
          && get(/databases/$(db)/documents/invites/$(request.resource.data.inviteCode)).data.role == request.resource.data.role
          && get(/databases/$(db)/documents/invites/$(request.resource.data.inviteCode)).data.limited == request.resource.data.limited
          && get(/databases/$(db)/documents/invites/$(request.resource.data.inviteCode)).data.perms == request.resource.data.perms
          && get(/databases/$(db)/documents/invites/$(request.resource.data.inviteCode)).data.createdAt > request.time.toMillis() - 1209600000
          && getAfter(/databases/$(db)/documents/invites/$(request.resource.data.inviteCode)).data.used == true )
      );
      allow update: if isOwner(resource.data.companyId)
        && request.resource.data.companyId == resource.data.companyId;
      allow delete: if isOwner(resource.data.companyId) && request.auth.uid != uid;
    }

    match /companies/{cid} {
      allow read: if inCompany(cid);
      allow create: if signedIn() && !hasMe() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isOwner(cid);

      // clientes, OS, orçamentos, estoque, financeiro… (cada tipo é uma "gaveta")
      match /cols/{c}/items/{id} {
        allow read: if inCompany(cid) && canCol(c);
        // quem fecha a OS (ex.: técnico) pode CRIAR a cobrança a receber, mas não lê nem altera o financeiro
        allow create: if inCompany(cid)
          && (canCol(c) || (c == 'finance' && request.resource.data.type == 'receber' && request.resource.data.paid == false))
          && (c != 'meta' || id != 'settings' || me().role == 'dono');
        allow update, delete: if inCompany(cid) && canCol(c)
          && (c != 'meta' || id != 'settings' || me().role == 'dono');
      }
    }

    // convites da equipe
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && isOwner(resource.data.companyId);
      allow create: if isOwner(request.resource.data.companyId) && request.resource.data.used == false;
      allow delete: if isOwner(resource.data.companyId);
      allow update: if signedIn() && !hasMe() && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
        && existsAfter(/databases/$(db)/documents/users/$(request.auth.uid));
    }
  }
}
